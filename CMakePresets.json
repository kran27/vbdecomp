{
  "version": 9,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x86",
      "inherits": "windows-base",
      "displayName": "Win32",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/.cache/main/windows-x86",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x86-windows-static"
      }
    },
    {
      "name": "windows-x64",
      "inherits": "windows-base",
      "displayName": "Win64",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/.cache/main/windows-x64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x86-dev",
      "displayName": "Win32 Debug",
      "configurePreset": "windows-x86",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "windows-x86-rel",
      "displayName": "Win32 Release",
      "configurePreset": "windows-x86",
      "configuration": "Release",
      "jobs": 4
    },
    {
      "name": "windows-x64-dev",
      "displayName": "Win64 Debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "jobs": 4
    },
    {
      "name": "windows-x64-rel",
      "displayName": "Win64 Release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "jobs": 4
    }
  ]
}